{
  "name": "explainer-studio",
  "productName": "Explainer Studio",
  "version": "1.0.3",
  "description": "Turn any learning material into long-form YouTube explainer videos",
  "main": "./out/main/index.js",
  "author": "Sarfraz",
  "repository": {
    "type": "git",
    "url": "https://github.com/sarfraznawaz2005/explainer-studio.git"
  },
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "bundle:video": "node scripts/bundle-video.mjs",
    "icon": "electron scripts/make-icon.cjs",
    "dist": "npm run typecheck && electron-vite build && npm run bundle:video && electron-builder --win --publish never",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:render": "vitest run -c vitest.render.config.ts",
    "test:voice": "vitest run -c vitest.voice.config.ts",
    "test:ingest": "vitest run -c vitest.ingest.config.ts",
    "test:planner": "vitest run -c vitest.planner.config.ts",
    "pack": "electron-vite build && npm run bundle:video && electron-builder --win dir --publish never"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.78",
    "@ai-sdk/deepseek": "^3.0.63",
    "@ai-sdk/google": "^4.0.93",
    "@ai-sdk/groq": "^4.0.59",
    "@ai-sdk/openai": "^4.0.91",
    "@ai-sdk/openai-compatible": "^3.0.67",
    "@ai-sdk/provider": "^4.0.26",
    "@ai-sdk/xai": "^5.0.20",
    "@anthropic-ai/claude-agent-sdk": "^0.3.295",
    "@remotion/bundler": "4.0.537",
    "@remotion/player": "4.0.537",
    "@remotion/renderer": "4.0.537",
    "ai": "^7.0.137",
    "cheerio": "^1.2.0",
    "katex": "^0.19.0",
    "mammoth": "^1.13.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remotion": "4.0.537",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-router": "^1.170.41",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "electron": "~42.11.12",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "radix-ui": "^1.4.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^5.0.3",
    "zustand": "^5.0.15"
  }
}
